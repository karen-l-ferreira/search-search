# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" de verdade pro GitHub (ele já está no .gitignore).
# Só é usado pela Opção B (servidor tradicional). No Vercel, esses valores vão
# em Environment Variables dentro do painel do projeto, não neste arquivo.

LEMIT_TOKEN=seu_token_do_lemit_aqui
AC_API_TOKEN=sua_api_key_do_activecampaign_aqui
AC_BASE_URL=https://gcbinvestimentos.activehosted.com
PORT=3000
